{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/projects",
      "destination": "https://ubuntu-s-1vcpu-2gb-nyc1.tail5eff67.ts.net/projects"
    },
    {
      "source": "/api/projects/:path*",
      "destination": "https://ubuntu-s-1vcpu-2gb-nyc1.tail5eff67.ts.net/projects/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://ubuntu-s-1vcpu-2gb-nyc1.tail5eff67.ts.net/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ubuntu-s-1vcpu-2gb-nyc1.tail5eff67.ts.net/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
