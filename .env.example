# Keep the API origin out of source code when it differs by environment.
# With the default /api value, Vite and Vercel proxy the requests server-side.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://ubuntu-s-1vcpu-2gb-nyc1.tail5eff67.ts.net

# Public token required by the Mapbox map component. Never commit private tokens.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token
